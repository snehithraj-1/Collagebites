{
  "name": "campus-bites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev": "node scripts/dev.js",
    "dev:student": "vite student-app --config student-app/vite.config.js --port 5173 --host",
    "dev:admin": "vite admin-app --config admin-app/vite.config.js --port 5174 --host",
    "build": "vite build student-app --config student-app/vite.config.js && vite build admin-app --config admin-app/vite.config.js",
    "build:student": "vite build student-app --config student-app/vite.config.js",
    "build:admin": "vite build admin-app --config admin-app/vite.config.js",
    "preview:student": "vite preview student-app --config student-app/vite.config.js --port 5173",
    "preview:admin": "vite preview admin-app --config admin-app/vite.config.js --port 5174"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "nodemailer": "^10.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  }
}
